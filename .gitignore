# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Mixkit clips (Mixkit Free License): kept out of git for size
/public/lab/*.mp4

# impeccable: local caches, decision-page state, review captures
/.impeccable/hook.cache.json
/.impeccable/questions/
/.impeccable/review/

# local labs: never committed, so never on GitHub Pages
/app/[[]lang]/lab/
/app/lab/
